APP_NAME=Acortador
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://go.gustavoquintero.dev
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=
DB_PORT=3306
DB_DATABASE=acortador
DB_USERNAME=app_acortador
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
CACHE_PREFIX=acortador-cache-
QUEUE_CONNECTION=sync

REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_PREFIX=acortador-
